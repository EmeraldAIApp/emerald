# Copy to .env (never committed). On Vercel, set them in Project Settings -> Environment Variables.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
RPC_URL=https://ethereum-rpc.publicnode.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# >= 32 characters: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Empty until the token launches
EMERALD_TOKEN_ADDRESS=
CREATOR_ADDRESS=
FEE_ESCROW=0xAcefe251da006887dA41C063D06CC82A060824BA
WETH=0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2
DAILY_SPEND_CAP_USD=20
# Optional: the public host (example.com, no scheme) when the Host header is not it. SIWE domain + same-origin check.
PUBLIC_HOST=
# Read by the front end at build time (plan 2): same value as EMERALD_TOKEN_ADDRESS
VITE_EMERALD_TOKEN_ADDRESS=
# The brand's public repo (https://github.com/<org>/<repo>); empty = "GitHub: soon".
VITE_GITHUB_URL=
# The site's https origin for an absolute og:image (X needs it); empty = relative path.
SITE_URL=
