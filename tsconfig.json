{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node", "vite/client"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": { "@engine/*": ["./engine/*"] }
  },
  "include": ["api", "server", "engine", "scripts", "web/src", "web/test", "web/mock", "web/build", "vite.config.ts", "vitest.config.ts", "kit"]
}
